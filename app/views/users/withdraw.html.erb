<div class="mypage-container withdraw-page">

  <div class="mypage">
    <h2 class="mypage-title">退会確認</h2>
  </div>

  <main class="user_formbox">
    <div class="withdraw-content">
      <p class="withdraw-warning">
        退会の場合、会員登録情報が全て削除されます。<br>
        本当によろしいですか？
      </p>
      <div class="processing-box">
        <%= link_to '戻る', user_path(current_user), class: "btn-cancel" %>
        <%= link_to '退会する', users_path(@user), method: :delete, class: "btn-withdraw", data: { confirm: '本当に削除してよろしいですか？' } %>
      </div>
    </div>
  </main>

</div>

