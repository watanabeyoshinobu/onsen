<%= render "blogs/menu" %>

<div class="withdraw-container">
	<p class="withdraw-title">退会しますか？</p>

		<p class="withdraw-text">
				退会した場合、会員登録情報が全て削除されます。<br>
				よろしいですか？
		</p>
		<div class="processing-box">
				<%= link_to '戻る', user_path(current_user),class: "btn btn--cancel btn--border-solid"%>
				<%= link_to '退会する', users_path(@user), method: :delete ,class: "btn btn--withdraw btn--border-solid",data: { confirm: '削除しますか？' }%>
		</div>
</div>

