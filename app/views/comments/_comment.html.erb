<div class="b-comment__item">
  <div class="b-comment__avatar">
    <% if comment.user.profile_image.present? %>
      <%= link_to image_tag(comment.user.profile_image.to_s, class: "avatar-image"), show_modal_user_path(comment_id: comment.id), remote: true %>
    <% else %>
      <%= link_to show_modal_user_path(comment_id: comment.id), remote: true, class: "avatar-text" do %>
        <div class="no-image-avatar"><%= comment.user.name.first %></div>
      <% end %>
    <% end %>
  </div>

  <div class="b-comment__content">
    <div class="b-comment__meta">
      <span class="comment-user-name"><%= comment.user.name %></span>
      <span class="comment-date"><%= comment.created_at.strftime('%Y/%m/%d') %></span>
      
      <% if user_signed_in? && comment.user == current_user %>
        <%= link_to comment, method: :delete, data: { confirm: "コメントを削除しますか？" }, class: "comment-delete-btn" do %>
          <i class="fa fa-trash"></i> 削除
        <% end %>
      <% end %>
    </div>

    <div class="b-comment__text">
      <%= simple_format(comment.comment) %>
    </div>
  </div>
</div>



