<div class="b-index_container">
  
  <div class="b-index-header">
    <div class="b-index__title">
      <p class="b-index__title-text">湯巡り録</p>
    </div>
    
    <div class="b-index__action">
      <%= link_to '湯巡りの綴りへ', new_blog_path, class: 'btn-border-button' %>
    </div>
  </div>

  <div class="b-index-grid">
    <% @blogs.each do |blog| %>
      <div class="b-card">
        <%= link_to blog_path(blog), class: "b-card__link" do %>
          
          <div class="b-card__image-box">
            <% if blog.image.present? %>
              <%= image_tag blog.image.to_s, class: "b-card__image" %>
            <% else %>
              <div class="b-card__no-image">♨️</div>
            <% end %>
          </div>

          <div class="b-card__body">
            <p class="b-card__date"><%= blog.created_at.strftime('%Y.%m.%d') %></p>
            <h3 class="b-card__title"><%= blog.title.truncate(15) %></h3>
            <p class="b-card__user">
              <i class="fa fa-user-circle"></i> <%= blog.user.name %>
            </p>
            <span class="b-card__more">詳細を見る &gt;</span>
          </div>
          
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="b-pagination">
    <%= paginate @blogs %>
  </div>

</div>
