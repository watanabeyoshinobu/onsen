<% if flash[:error_messages] %>
  <div class="alert alert-danger">
    <ul>
      <% flash[:error_messages].each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= render 'shared/error_messages', object: f.object rescue nil %>

<%= form_for @blog do |f| %>
  <div class="b-blog__formbox">
    
    <div class="b-title_box">
      <%= f.label :title, '住所・施設名' %>
      <%= f.text_field :title, class: 'form-control', placeholder: '例：神奈川県横浜市 〇〇の湯' %>
      <small id="title-tip" class="form-text text-muted">
        住所・施設名を入力してください
      </small>
    </div>

    <div class="b-content_box">
      <%= f.label :body, '投稿内容' %>
      <%= f.text_area :body, class: 'form-control', rows: 8, placeholder: '施設の感想やおすすめポイントを書いてみましょう' %>
      <small id="content-tip" class="form-text text-muted">
        投稿内容を入力してください(300文字以内)
      </small>
    </div>
        
    <div class="b-image_box">
      <%= f.file_field :image, accept: 'image/jpeg,image/gif,image/png' %>
      <input type="hidden" name="blog_image_update_flg" value="blog_image_update_flg" >
    </div>

    <div class="b-push_box">
      <%= f.submit '投稿', class: 'decorated-btn click-down' %>
    </div>
    
  </div>
<% end %>
