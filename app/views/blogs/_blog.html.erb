<div class="blog-card">
  <div class="blog-header">
    <h1 class="blog-title"><%= @blog.title %></h1>
    <div class="blog-meta">
      <span class="blog-author">
        <i class="fa fa-user"></i> <%= @blog.user.name %>
      </span>

      <% if user_signed_in? && @blog.user != current_user %>
        <span class="blog-follow-area">
          <div class="follow-button-component"
              data-user-id="<%= @blog.user.id %>"
              data-following="<%= current_user.following?(@blog.user) %>">
          </div>
        </span>
      <% end %>
      <span class="blog-date">
        <%= @blog.created_at.strftime('%Y/%m/%d') %>
      </span>
    </div>
  </div>

  <div class="blog-body">
    <% if @blog.image.present? %>
      <div class="blog-image-container">
        <%= image_tag @blog.image.to_s, class: 'blog-image' %>
      </div>
    <% end %>
    
    <div class="blog-text">
      <%= simple_format(@blog.body) %>
    </div>
  </div>

  <div class="blog-footer">
    <div class="blog-actions">
      <% if user_signed_in? %>
        <div class="favorite-button-component"
            data-blog-id="<%= @blog.id %>"
            data-favorited="<%= @blog.favorited_by?(current_user) %>"
            data-count="<%= @blog.favorites.count %>">
        </div>
      <% else %>
        <div class="favorite-btn">
          <i class="fa fa-heart-o" aria-hidden="true"></i>
          <span><%= @blog.favorites.count %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>