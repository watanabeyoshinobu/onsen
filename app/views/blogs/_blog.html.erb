<div class="b-card_box">
	  <div class="card-header">
	      <p class="card-title"><%= @blog.title %></p>
	  </div>

	  <div class="card-body">
				<figure class="card-image">
					<% if @blog.image.present? %>
						<%= image_tag @blog.image.to_s, :size =>'200x200' %>
					<% end %>
				</figure>
				<div class="card-text">
					<p><%= simple_format(@blog.body) %></p>
				</div>
	  </div>

	  <ul class="card-footer">
	      <%= @blog.user.name %>
				<% if @blog.present? %>
				  <% if @blog.favorited_by?(current_user) %>
						<li class="card-footer">
							<%= link_to blog_favorites_path(@blog), method: :delete do %>
								<i class="fa fa-heart" aria-hidden="true" style="color: red;"></i>
									<%= @blog.favorites.count %>
							<% end %>
						</li>
							<% else %>
						<li>
							<%= link_to blog_favorites_path(@blog), method: :post do %>
								<i class="fa fa-heart" aria-hidden="true" style="color: red;"></i>
									<%= @blog.favorites.count %>
							<% end %>
						</li>
				  <% end %>
			<% end %>
		</ul>
</div>